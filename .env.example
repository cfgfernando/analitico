# ==============================================================================
# SAAS FISCAL MULTI-TENANT PARA PREFEITURAS (V4) - CONFIGURAÇÃO DE AMBIENTE
# Copie este arquivo para '.env' e configure os valores correspondentes.
# NUNCA comite o arquivo '.env' real no repositório Git.
# ==============================================================================

# SERVIDOR & APLICAÇÃO
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# BANCO DE DADOS (MySQL 8 via Prisma ORM)
DATABASE_URL="mysql://root:password@localhost:3306/saas_fiscal_prefeituras"

# AUTENTICAÇÃO E SEGURANÇA (JWT)
# Gere chaves fortes (ex: openssl rand -base64 32)
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-super-secret-refresh-jwt-key-min-32-chars"
JWT_REFRESH_EXPIRES_IN="7d"

# CRIPTOGRAFIA DE CREDENCIAIS (AES-256-GCM)
# Chave mestra de 32 bytes (64 caracteres hexadecimais, ex: openssl rand -hex 32)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# INTELIGÊNCIA ARTIFICIAL (Google Gemini)
GEMINI_API_KEY="your-google-gemini-api-key-here"

# FILAS & CACHE DISTRIBUÍDO (Redis + BullMQ)
REDIS_URL="redis://localhost:6379"

